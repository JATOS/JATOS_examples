{
  "name": "jatos-js-study-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright wrapper for the jatos.js test study",
  "scripts": {
    "test": "playwright test",
    "test:min": "JATOS_SCRIPT=jatos.min.js playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:slim": "JATOS_SCRIPT=jatos-slim.js playwright test",
    "test:slim:min": "JATOS_SCRIPT=jatos-slim.min.js playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2"
  }
}
